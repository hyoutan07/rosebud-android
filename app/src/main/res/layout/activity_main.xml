<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/content" android:padding="@dimen/content_padding">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="10dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_1" android:textSize="25sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:textStyle="bold" />
    <TextView android:textSize="11sp" android:id="@+id/app_version" android:layout_width="match_parent" android:layout_height="wrap_content" />
  </LinearLayout>
  <TextView android:id="@+id/session_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8E5058" android:textSize="12sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
  <ScrollView android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/screen_session">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_2" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/session_chips" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_3" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" />
        <Spinner android:id="@+id/scenario" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/ui_3" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_4" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/scenario_note" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_5" android:textSize="48sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/elapsed" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_6" android:textSize="14sp" android:textColor="#4C7568" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/phase" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_7" android:textSize="11sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/timeline" />
        <LinearLayout android:id="@+id/stage_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/skip_middle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/skip_middle" android:minHeight="48dp" android:textSize="13sp" />
          <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/skip_finish" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/skip_finish" android:minHeight="48dp" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/progress_detail" android:textSize="12sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:id="@+id/progress_detail" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel" android:padding="18dp" android:layout_marginTop="12dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_8" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/strength" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_9" android:textSize="22sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/recipe_name" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_10" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/recipe_hint" />
          <TextView android:id="@+id/flicker_motion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flicker_motion" android:textSize="16sp" android:textColor="#946570" android:paddingTop="12dp" android:paddingBottom="12dp" />
          <jp.hyoutan.rosebud.MotionWaveView android:id="@+id/session_wave" android:layout_width="match_parent" android:layout_height="95dp" android:contentDescription="@string/ui_11" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_12" android:textSize="11sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" />
        </LinearLayout>
        <TextView android:id="@+id/vibrate_label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/vibrate_cap" android:layout_width="match_parent" android:layout_height="48dp" android:min="5" android:max="100" android:contentDescription="@string/vibrate_cap" />
        <TextView android:id="@+id/flicker_label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/flicker_cap" android:layout_width="match_parent" android:layout_height="48dp" android:min="5" android:max="100" android:contentDescription="@string/flicker_cap" />
        <CheckBox android:id="@+id/audio_follow" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/audio_follow" />
        <Button android:id="@+id/toggle_control" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_13" android:minHeight="48dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/control_details" android:visibility="gone">
          <TextView android:id="@+id/control_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/screen_patterns" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_14" android:textSize="24sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_15" android:textSize="14sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_16" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/pattern_active" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/recipe_cards" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_17" android:textSize="20sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/sample_title" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_18" android:textSize="14sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/sample_description" />
        <jp.hyoutan.rosebud.MotionWaveView android:id="@+id/sample_wave" android:layout_width="match_parent" android:layout_height="100dp" android:contentDescription="@string/ui_19" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_20" android:textSize="14sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" android:id="@+id/sample_sequence" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_21" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/screen_settings" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_22" android:textSize="24sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_23" android:textSize="14sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" />
        <Button android:id="@+id/toggle_trial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/open_trial" android:minHeight="48dp" />
        <LinearLayout android:id="@+id/trial_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/panel" android:visibility="gone">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trial_title" android:textSize="18sp" android:paddingTop="8dp" android:paddingBottom="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trial_help" android:textSize="12sp" android:paddingTop="8dp" android:paddingBottom="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trial_percent_label" android:textSize="14sp" android:paddingTop="8dp" android:paddingBottom="8dp" />
          <EditText android:id="@+id/trial_percent" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="number" android:hint="@string/trial_unset_percent" android:maxLength="3" android:importantForAutofill="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trial_duration_label" android:textSize="14sp" android:paddingTop="8dp" android:paddingBottom="8dp" />
          <EditText android:id="@+id/trial_seconds" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="numberDecimal" android:hint="@string/trial_unset_seconds" android:maxLength="6" android:importantForAutofill="no" />
          <Button android:id="@+id/trial_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trial_start" android:minHeight="48dp" android:enabled="false" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trial_status" android:textSize="12sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:id="@+id/trial_status" android:accessibilityLiveRegion="polite" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trial_stop_hint" android:textSize="12sp" android:paddingTop="8dp" android:paddingBottom="8dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_24" android:textSize="18sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:textStyle="bold" />
        <EditText android:id="@+id/server_url" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="textUri|textNoSuggestions" android:imeOptions="actionDone|flagForceAscii" android:singleLine="true" android:hint="@string/server_url_hint" android:importantForAutofill="no" />
        <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connect" />
        <TextView android:id="@+id/connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scan" />
        <Spinner android:id="@+id/devices" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/devices" />
        <Button android:id="@+id/select_device" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/select_device" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_25" android:textSize="18sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:textStyle="bold" />
        <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ready" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/meter" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="24dp" android:max="1200" android:contentDescription="@string/meter_hint" />
        <TextView android:id="@+id/levels" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_26" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_27" android:textSize="18sp" android:textColor="#313D39" android:paddingTop="7dp" android:paddingBottom="7dp" android:textStyle="bold" />
        <CheckBox android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/ui_28" android:checked="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_29" android:textSize="12sp" android:textColor="#787470" android:paddingTop="7dp" android:paddingBottom="7dp" />
        <Button android:id="@+id/toggle_diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_30" android:minHeight="48dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/diagnostics" android:visibility="gone">
          <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stop" />
          <Spinner android:id="@+id/browser" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/browsers" />
          <EditText android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/condition_hint" android:inputType="textCapSentences|textMultiLine" android:maxLength="240" android:maxLines="3" android:importantForAutofill="no" />
          <CheckBox android:id="@+id/wake_lock" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/wake_lock_option" />
          <Button android:id="@+id/mark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mark" />
          <Button android:id="@+id/share" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/share" />
          <Button android:id="@+id/settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings" />
          <TextView android:id="@+id/metrics" android:layout_width="match_parent" android:layout_height="wrap_content" />
          <TextView android:id="@+id/session" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textIsSelectable="true" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <Button android:id="@+id/motion_start" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_31" android:layout_weight="1" android:backgroundTint="#4C7568" android:textColor="#FFFFFF" />
      <Button android:id="@+id/all_stop" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_32" android:layout_weight="1" android:backgroundTint="#EEDCDA" android:textColor="#8E5058" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <Button android:id="@+id/tab_session" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_33" android:minHeight="48dp" android:layout_weight="1" android:textSize="12sp" style="?android:attr/buttonBarButtonStyle" />
      <Button android:id="@+id/tab_patterns" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_34" android:minHeight="48dp" android:layout_weight="1" android:textSize="12sp" style="?android:attr/buttonBarButtonStyle" />
      <Button android:id="@+id/tab_settings" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_22" android:minHeight="48dp" android:layout_weight="1" android:textSize="12sp" style="?android:attr/buttonBarButtonStyle" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>